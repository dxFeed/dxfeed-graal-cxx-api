# Verify the complete pinned upstream include tree without downloads.
file(READ "${CMAKE_CURRENT_LIST_DIR}/manifest.json" pfr_manifest)
string(JSON pfr_count LENGTH "${pfr_manifest}" files)
math(EXPR pfr_last "${pfr_count} - 1")
foreach(index RANGE 0 ${pfr_last})
  string(JSON path GET "${pfr_manifest}" files ${index} path)
  string(JSON expected GET "${pfr_manifest}" files ${index} sha256)
  string(JSON expected_size GET "${pfr_manifest}" files ${index} bytes)
  file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/${path}" actual)
  file(SIZE "${CMAKE_CURRENT_LIST_DIR}/${path}" actual_size)
  if(NOT actual STREQUAL expected OR NOT actual_size EQUAL expected_size)
    message(FATAL_ERROR "Pinned PFR artifact changed: vendor/pfr/${path}")
  endif()
endforeach()
