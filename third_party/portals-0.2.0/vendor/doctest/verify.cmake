# Verify the pinned doctest source without downloads.
get_filename_component(portals_source_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
file(READ "${portals_source_root}/vendor/doctest/manifest.json" manifest)
string(JSON count LENGTH "${manifest}" files)
math(EXPR last "${count} - 1")
foreach(index RANGE 0 ${last})
  string(JSON name GET "${manifest}" files ${index} name)
  string(JSON expected GET "${manifest}" files ${index} sha256)
  string(JSON expected_size GET "${manifest}" files ${index} bytes)
  set(path "${portals_source_root}/vendor/doctest/${name}")
  file(SHA256 "${path}" actual)
  file(SIZE "${path}" actual_size)
  if(NOT actual STREQUAL expected OR NOT actual_size EQUAL expected_size)
    message(FATAL_ERROR "Pinned doctest artifact changed: vendor/doctest/${name}")
  endif()
endforeach()
