cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/../tools/package/common.cmake")
if(DEFINED TEST_ROOT_DIR)
  if(NOT IS_ABSOLUTE "${TEST_ROOT_DIR}")
    message(FATAL_ERROR "TEST_ROOT_DIR must be absolute")
  endif()
  cmake_path(NORMAL_PATH TEST_ROOT_DIR OUTPUT_VARIABLE testRoot)
  if(EXISTS "${testRoot}")
    file(REAL_PATH "${testRoot}" testRoot)
  endif()
  file(REAL_PATH "${CMAKE_CURRENT_LIST_DIR}/.." projectRoot)
  set(comparableRoot "${testRoot}")
  if(CMAKE_HOST_WIN32)
    string(TOLOWER "${comparableRoot}" comparableRoot)
    string(TOLOWER "${projectRoot}" projectRoot)
  endif()
  if(comparableRoot STREQUAL projectRoot)
    message(FATAL_ERROR "TEST_ROOT_DIR cannot be the project source root")
  endif()
  string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef fixtureId)
  set(TEST_WORK_DIR "${testRoot}/${fixtureId}")
endif()
bundleRequireNewPath(TEST_WORK_DIR)
if(NOT DEFINED fixtureId)
  string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef fixtureId)
endif()
file(MAKE_DIRECTORY "${TEST_WORK_DIR}")
file(WRITE "${TEST_WORK_DIR}/.fixture-owner" "${fixtureId}")
get_filename_component(evidenceRoot "${TEST_WORK_DIR}" DIRECTORY)
find_program(GIT_EXECUTABLE NAMES git REQUIRED)
set(packager "${CMAKE_CURRENT_LIST_DIR}/../tools/release/package.cmake")
set(source "${TEST_WORK_DIR}/source")
file(MAKE_DIRECTORY "${source}")
file(WRITE "${source}/README.txt" "Packaging fixture\n")
file(MAKE_DIRECTORY "${source}/examples/consumer")
file(WRITE "${source}/examples/consumer/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.24)
project(ReleaseConsumerFixture LANGUAGES C CXX)
if(NOT FETCHCONTENT_FULLY_DISCONNECTED OR NOT CMAKE_BUILD_TYPE STREQUAL "Release")
  message(FATAL_ERROR "Expected explicit offline Release consumer configuration")
endif()
foreach(option IN ITEMS TESTS EXAMPLES TOOLS DOCS FUZZERS)
  if(PORTALS_BUILD_${option})
    message(FATAL_ERROR "Consumer should not enable unrelated build targets")
  endif()
endforeach()
add_executable(portals_consumer main.cpp)
]=])
file(WRITE "${source}/examples/consumer/main.cpp" "int main() { return 0; }\n")
bundleRun("${GIT_EXECUTABLE}" -C "${source}" init --quiet)
bundleRun("${GIT_EXECUTABLE}" -C "${source}" add README.txt examples)
bundleRun("${GIT_EXECUTABLE}" -C "${source}" -c user.name=Fixture
  -c user.email=fixture@example.invalid -c commit.gpgsign=false commit --quiet -m fixture)
bundleRun("${GIT_EXECUTABLE}" -C "${source}" tag v1.2.3)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" rev-parse HEAD
  OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
file(MAKE_DIRECTORY "${source}/.work")
file(WRITE "${source}/.work/private.txt" "Private state must not enter source archives\n")

function(createInputs caseName)
  set(platform windows)
  set(toolchain msvc)
  set(extension zip)
  if(ARGC GREATER 1)
    set(platform "${ARGV1}")
    set(toolchain gcc14)
    set(extension tar.gz)
  endif()
  set(root "${TEST_WORK_DIR}/${caseName}")
  set(payload "${root}/bundle/portals-mvp-${platform}-x64-release")
  set(output "${root}/output")
  file(MAKE_DIRECTORY "${payload}" "${output}")
  file(WRITE "${payload}/README.txt" "Verified payload fixture\n")
  file(SHA256 "${payload}/README.txt" payloadHash)
  set(files "{\"README.txt\":\"${payloadHash}\"}")
  if(platform STREQUAL linux)
    file(MAKE_DIRECTORY "${payload}/docs/html")
    file(WRITE "${payload}/docs/html/index.html" "<!doctype html><title>Fixture documentation</title>\n")
    file(SHA256 "${payload}/docs/html/index.html" htmlHash)
    string(JSON files SET "${files}" docs/html/index.html "\"${htmlHash}\"")
  endif()
  set(manifest "{\"schema_version\":1,\"commit\":\"${commit}\",\"configuration\":\"Release\",\"platform\":\"${platform}\",\"architecture\":\"x64\",\"linkStatus\":\"passed\",\"files\":${files}}")
  file(WRITE "${payload}/manifest.json" "${manifest}\n")
  set(archive "${output}/portals-v1.2.3-${platform}-x64-release.${extension}")
  if(platform STREQUAL linux)
    set(archiveArguments czf "${archive}" --format=gnutar)
  else()
    set(archiveArguments cf "${archive}" --format=zip)
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar ${archiveArguments}
    "portals-mvp-${platform}-x64-release" WORKING_DIRECTORY "${root}/bundle"
    COMMAND_ERROR_IS_FATAL ANY)
  file(SHA256 "${archive}" archiveHash)
  file(WRITE "${root}/bundle/bundle-receipt.txt"
    "commit=${commit}\nsha256=${archiveHash}\nconfiguration=Release\nheadless_bundle_smoke=passed\n")
  foreach(configuration IN ITEMS Debug Release)
    file(WRITE "${root}/${configuration}.json"
      "{\"schema_version\":1,\"tag\":\"v1.2.3\",\"commit\":\"${commit}\",\"platform\":\"${platform}\",\"configuration\":\"${configuration}\",\"toolchain\":\"${toolchain}\",\"headless\":\"passed\"}\n")
  endforeach()
  set(caseRoot "${root}" PARENT_SCOPE)
  set(arguments "-DSOURCE_DIR=${source}" "-DSOURCE_REVISION=${commit}" -DRELEASE_TAG=v1.2.3
    "-DPLATFORM=${platform}" "-DPAYLOAD_DIR=${payload}" "-DOUTPUT_DIR=${output}"
    "-DWORK_DIR=${root}/work" -DCONFIGURATION=Release -DPARALLEL=1 "-DTOOLCHAIN=${toolchain}"
    "-DDEBUG_GATE_RECEIPT=${root}/Debug.json" "-DRELEASE_GATE_RECEIPT=${root}/Release.json"
    PARENT_SCOPE)
endfunction()

function(expectFailure diagnostic)
  execute_process(COMMAND "${CMAKE_COMMAND}" ${arguments} ${ARGN} -P "${packager}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(result EQUAL 0 OR NOT "${output}\n${error}" MATCHES "${diagnostic}")
    message(FATAL_ERROR "Expected failure '${diagnostic}'; result=${result}: ${output}\n${error}")
  endif()
  if(EXISTS "${caseRoot}/output/release-manifest-windows.json")
    message(FATAL_ERROR "Rejected inputs produced a release manifest")
  endif()
endfunction()

createInputs(success)
bundleRun("${CMAKE_COMMAND}" ${arguments} -P "${packager}")
file(READ "${caseRoot}/output/release-manifest-windows.json" manifest)
foreach(field IN ITEMS commit tag platform configuration architecture)
  string(JSON actual GET "${manifest}" "${field}")
  if(field STREQUAL "commit")
    set(expected "${commit}")
  elseif(field STREQUAL "tag")
    set(expected v1.2.3)
  elseif(field STREQUAL "platform")
    set(expected windows)
  elseif(field STREQUAL "configuration")
    set(expected Release)
  else()
    set(expected x64)
  endif()
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Manifest ${field} mismatch")
  endif()
endforeach()
string(JSON count LENGTH "${manifest}" artifacts)
string(JSON actualHash GET "${manifest}" artifacts 0 sha256)
string(JSON actualSize GET "${manifest}" artifacts 0 size)
string(JSON actualName GET "${manifest}" artifacts 0 name)
file(SHA256 "${caseRoot}/output/${actualName}" expectedHash)
file(SIZE "${caseRoot}/output/${actualName}" expectedSize)
if(NOT count EQUAL 1 OR NOT actualHash STREQUAL expectedHash OR NOT actualSize EQUAL expectedSize)
  message(FATAL_ERROR "Manifest artifact inventory/hash/size mismatch")
endif()
foreach(gate IN ITEMS debug_headless release_headless bundle_smoke html_links)
  string(JSON status GET "${manifest}" gates "${gate}")
  if(NOT status STREQUAL passed)
    message(FATAL_ERROR "Expected successful fixture gate: ${gate}")
  endif()
endforeach()
file(COPY_FILE "${caseRoot}/output/release-manifest-windows.json"
  "${evidenceRoot}/${fixtureId}-windows-manifest.json")
execute_process(COMMAND "${CMAKE_COMMAND}" ${arguments} -P "${packager}"
  RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0)
  message(FATAL_ERROR "Existing packaging paths were reused")
endif()

createInputs(existingWork)
file(MAKE_DIRECTORY "${caseRoot}/work")
file(WRITE "${caseRoot}/work/keep.txt" "Preserve me")
expectFailure("WORK_DIR already exists")
file(READ "${caseRoot}/work/keep.txt" kept)
if(NOT kept STREQUAL "Preserve me")
  message(FATAL_ERROR "Existing work was modified")
endif()

createInputs(wrongTag)
expectFailure("Unsupported release tag" -DRELEASE_TAG=v01.2.3)
createInputs(wrongConfiguration)
expectFailure("CONFIGURATION=Release" -DCONFIGURATION=Debug)
createInputs(wrongToolchain)
expectFailure("gate receipt toolchain differs" -DTOOLCHAIN=clang)
createInputs(missingCompiler)
foreach(configuration IN ITEMS Debug Release)
  file(READ "${caseRoot}/${configuration}.json" receipt)
  string(REPLACE "windows" "linux" receipt "${receipt}")
  file(WRITE "${caseRoot}/${configuration}.json" "${receipt}")
endforeach()
expectFailure("Offline source consumer requires explicit C_COMPILER" -DPLATFORM=linux)
createInputs(failedGate)
file(WRITE "${caseRoot}/Debug.json"
  "{\"schema_version\":1,\"tag\":\"v1.2.3\",\"commit\":\"${commit}\",\"platform\":\"windows\",\"configuration\":\"Debug\",\"toolchain\":\"msvc\",\"headless\":\"failed\"}")
expectFailure("gate receipt headless differs")
createInputs(damagedPayload)
file(APPEND "${caseRoot}/bundle/portals-mvp-windows-x64-release/README.txt" "Damage")
expectFailure("SHA256 mismatch")
createInputs(damagedArchive)
file(APPEND "${caseRoot}/output/portals-v1.2.3-windows-x64-release.zip" "Damage")
expectFailure("Bundle receipt missing verified")
createInputs(extraOutput)
file(WRITE "${caseRoot}/output/unlisted.txt" "Unlisted")
expectFailure("initially contain only")
createInputs(unsafeWork)
expectFailure("WORK_DIR must be separate" "-DWORK_DIR=${source}/package-work")
if(EXISTS "${source}/package-work")
  message(FATAL_ERROR "Unsafe source-tree work path was created")
endif()
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
  foreach(required IN ITEMS C_COMPILER CXX_COMPILER GENERATOR)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
      message(FATAL_ERROR "Linux fixture requires explicit ${required}")
    endif()
  endforeach()
  createInputs(linuxSuccess linux)
  bundleRun("${CMAKE_COMMAND}" ${arguments} "-DC_COMPILER=${C_COMPILER}"
    "-DCXX_COMPILER=${CXX_COMPILER}" "-DGENERATOR=${GENERATOR}"
    "-DPAGES_DIR=${caseRoot}/pages" -P "${packager}")
  file(READ "${caseRoot}/output/release-manifest-linux.json" manifest)
  string(JSON count LENGTH "${manifest}" artifacts)
  if(NOT count EQUAL 4 OR NOT EXISTS "${caseRoot}/pages/index.html" OR
      NOT EXISTS "${caseRoot}/pages/.nojekyll")
    message(FATAL_ERROR "Linux fixture source/docs/Pages inventory incomplete")
  endif()
  if(EXISTS "${caseRoot}/work/source-unpack/portals-v1.2.3/.work")
    message(FATAL_ERROR "Private fixture state entered source archive")
  endif()
  foreach(index RANGE 0 3)
    string(JSON name GET "${manifest}" artifacts ${index} name)
    string(JSON hash GET "${manifest}" artifacts ${index} sha256)
    string(JSON size GET "${manifest}" artifacts ${index} size)
    file(SHA256 "${caseRoot}/output/${name}" actualHash)
    file(SIZE "${caseRoot}/output/${name}" actualSize)
    if(NOT hash STREQUAL actualHash OR NOT size EQUAL actualSize)
      message(FATAL_ERROR "Linux fixture artifact hash/size mismatch")
    endif()
  endforeach()
  file(COPY_FILE "${caseRoot}/output/release-manifest-linux.json"
    "${evidenceRoot}/${fixtureId}-linux-manifest.json")
endif()
createInputs(movedTag)
bundleRun("${GIT_EXECUTABLE}" -C "${source}" tag -f v1.2.3 HEAD:README.txt)
expectFailure("Checkout/tag differs")
file(WRITE "${evidenceRoot}/${fixtureId}.log"
  "release_package_fixture=passed\nhost=${CMAKE_HOST_SYSTEM_NAME}\nsource_commit=${commit}\nC_COMPILER=${C_COMPILER}\nCXX_COMPILER=${CXX_COMPILER}\nGENERATOR=${GENERATOR}\nSynthetic receipts do not represent acceptance of a real Portals build.\n")
# Delete only this invocation's new directory after checking its ownership marker.
file(READ "${TEST_WORK_DIR}/.fixture-owner" owner)
file(REAL_PATH "${TEST_WORK_DIR}" actualWork)
cmake_path(NORMAL_PATH TEST_WORK_DIR OUTPUT_VARIABLE expectedWork)
if(NOT owner STREQUAL fixtureId OR NOT actualWork STREQUAL expectedWork OR
    IS_SYMLINK "${TEST_WORK_DIR}")
  message(FATAL_ERROR "Refusing to clean an unrecognized fixture directory")
endif()
bundleRejectSymlinks("${TEST_WORK_DIR}")
file(REMOVE_RECURSE "${TEST_WORK_DIR}")
message(STATUS "Release packaging fixture validation passed: ${evidenceRoot}/${fixtureId}.log")
message(STATUS "Synthetic receipts do not represent acceptance of a real Portals build")
