# Verify trusted bundles in a new path with spaces/Unicode, from a foreign cwd.
cmake_minimum_required(VERSION 3.24)
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/common.cmake")
  include("${CMAKE_CURRENT_LIST_DIR}/common.cmake")
else()
  include("${CMAKE_CURRENT_LIST_DIR}/../tools/package/common.cmake")
endif()

if(DEFINED ARCHIVE)
  if(NOT IS_ABSOLUTE "${ARCHIVE}" OR NOT EXISTS "${ARCHIVE}")
    message(FATAL_ERROR "ARCHIVE must be an existing absolute archive path")
  endif()
  bundleRequireNewPath(TEST_WORK_DIR)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tf "${ARCHIVE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE archiveListing)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot list bundle archive")
  endif()
  if(archiveListing MATCHES ";")
    message(FATAL_ERROR "Unsafe archive filename contains a CMake list separator")
  endif()
  string(REPLACE "\r\n" "\n" archiveListing "${archiveListing}")
  string(REPLACE "\n" ";" archiveEntries "${archiveListing}")
  foreach(entry IN LISTS archiveEntries)
    if(NOT entry STREQUAL "")
      bundleValidateRelativePath("${entry}")
    endif()
  endforeach()
  file(MAKE_DIRECTORY "${TEST_WORK_DIR}/unpacked bundle é" "${TEST_WORK_DIR}/foreign cwd")
  file(ARCHIVE_EXTRACT INPUT "${ARCHIVE}" DESTINATION "${TEST_WORK_DIR}/unpacked bundle é")
  file(GLOB roots LIST_DIRECTORIES TRUE "${TEST_WORK_DIR}/unpacked bundle é/*")
  list(LENGTH roots rootCount)
  if(NOT rootCount EQUAL 1 OR NOT IS_DIRECTORY "${roots}")
    message(FATAL_ERROR "Bundle archive must contain one top-level directory")
  endif()
  set(BUNDLE_DIR "${roots}")
elseif(NOT DEFINED BUNDLE_DIR OR NOT IS_DIRECTORY "${BUNDLE_DIR}")
  message(FATAL_ERROR "Specify ARCHIVE and fresh TEST_WORK_DIR, or BUNDLE_DIR")
endif()
file(REAL_PATH "${BUNDLE_DIR}" BUNDLE_DIR)
bundleVerifyHashes("${BUNDLE_DIR}")
if(VERIFY_ONLY)
  message(STATUS "Bundle payload hashes and inventory verified")
  return()
endif()

foreach(required IN ITEMS docs/html/index.html GETTING-STARTED.md run.ps1 run.sh
    examples/external-consumer/CMakeLists.txt examples/external-consumer/main.cpp
    themes/modern.pss themes/turbo.pss data/data.hpp docs/limitations.md)
  if(NOT EXISTS "${BUNDLE_DIR}/${required}")
    message(FATAL_ERROR "Required bundle payload missing: ${required}")
  endif()
endforeach()
file(GLOB htmlFiles "${BUNDLE_DIR}/docs/html/*.html")
file(GLOB cssFiles "${BUNDLE_DIR}/docs/html/*.css")
file(GLOB jsFiles "${BUNDLE_DIR}/docs/html/*.js")
if(NOT htmlFiles OR NOT cssFiles OR NOT jsFiles)
  message(FATAL_ERROR "Generated HTML documentation and local resources are incomplete")
endif()
file(GLOB_RECURSE configs "${BUNDLE_DIR}/install/*/PortalsConfig.cmake")
file(GLOB_RECURSE targets "${BUNDLE_DIR}/install/*/PortalsTargets.cmake")
if(NOT configs OR NOT targets OR EXISTS "${BUNDLE_DIR}/.work" OR EXISTS "${BUNDLE_DIR}/.git")
  message(FATAL_ERROR "Installed SDK or bundle source separation is invalid")
endif()
file(READ "${BUNDLE_DIR}/manifest.json" manifest)
string(JSON platform GET "${manifest}" platform)
string(JSON configuration GET "${manifest}" configuration)
string(JSON runtime GET "${manifest}" MSVC_RUNTIME_LIBRARY)
if(NOT configuration STREQUAL "Release")
  message(FATAL_ERROR "Bundle is not Release")
endif()
if((CMAKE_HOST_WIN32 AND NOT platform STREQUAL "windows") OR
    (CMAKE_HOST_UNIX AND NOT platform STREQUAL "linux"))
  message(FATAL_ERROR "Bundle platform does not match this host")
endif()
if(NOT DEFINED TEST_WORK_DIR)
  message(FATAL_ERROR "Full smoke requires a new TEST_WORK_DIR outside the bundle")
endif()
if(NOT DEFINED ARCHIVE)
  bundleRequireNewPath(TEST_WORK_DIR)
  bundlePathIsInside("${BUNDLE_DIR}" "${TEST_WORK_DIR}" workInsideBundle)
  if(workInsideBundle)
    message(FATAL_ERROR "TEST_WORK_DIR must be outside the bundle")
  endif()
  file(MAKE_DIRECTORY "${TEST_WORK_DIR}/foreign cwd")
endif()

foreach(example IN ITEMS dashboard gallery custom_widget replay)
  string(JSON relative GET "${manifest}" examples "${example}")
  bundleValidateRelativePath("${relative}")
  if(example STREQUAL "replay")
    set(arguments --check --delay-ms 250)
  elseif(example STREQUAL "dashboard")
    set(arguments --check --ansi16 --ascii)
  else()
    set(arguments --check)
  endif()
  execute_process(COMMAND "${BUNDLE_DIR}/${relative}" ${arguments}
    WORKING_DIRECTORY "${TEST_WORK_DIR}/foreign cwd" TIMEOUT 30
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  file(WRITE "${TEST_WORK_DIR}/${example}-check.log" "${output}\n${error}\nresult=${result}\n")
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Finite ${example} check failed: ${result}; ${error}")
  endif()
endforeach()

# Relocate the SDK again and build a consumer with only its install prefix.
set(prefix "${TEST_WORK_DIR}/relocated SDK é")
set(consumerSource "${TEST_WORK_DIR}/consumer source")
set(consumerBuild "${TEST_WORK_DIR}/consumer build")
file(COPY "${BUNDLE_DIR}/install/" DESTINATION "${prefix}")
file(COPY "${BUNDLE_DIR}/examples/external-consumer/" DESTINATION "${consumerSource}")
if(NOT DEFINED GENERATOR)
  set(GENERATOR Ninja)
endif()
set(configureArgs -S "${consumerSource}" -B "${consumerBuild}" -G "${GENERATOR}"
  -DCMAKE_BUILD_TYPE=Release "-DCMAKE_PREFIX_PATH=${prefix}"
  -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF -DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF
  -DCMAKE_FIND_USE_CMAKE_ENVIRONMENT_PATH=OFF)
if(CMAKE_HOST_WIN32)
  list(APPEND configureArgs "-DCMAKE_MSVC_RUNTIME_LIBRARY=${runtime}")
endif()
if(DEFINED CXX_COMPILER)
  list(APPEND configureArgs "-DCMAKE_CXX_COMPILER=${CXX_COMPILER}")
else()
  string(JSON recordedCompiler GET "${manifest}" CMAKE_CXX_COMPILER)
  if(NOT EXISTS "${recordedCompiler}")
    message(FATAL_ERROR "Specify CXX_COMPILER compatible with the manifest tuple")
  endif()
  list(APPEND configureArgs "-DCMAKE_CXX_COMPILER=${recordedCompiler}")
endif()
file(GLOB_RECURSE exports "${prefix}/*.cmake")
foreach(export IN LISTS exports)
  file(READ "${export}" contents)
  foreach(forbidden IN ITEMS "${BUNDLE_DIR}" "${consumerSource}" ".work/" "/W4" "/permissive-"
      "-Wall" "-Wextra" "-Wpedantic" "UTF8PROC_STATIC" "vendor/utf8proc")
    string(FIND "${contents}" "${forbidden}" found)
    if(NOT found EQUAL -1)
      message(FATAL_ERROR "Source/build/private setting leaked through installed SDK: ${forbidden}")
    endif()
  endforeach()
endforeach()
foreach(export IN LISTS exports)
  file(READ "${export}" contents)
  foreach(variable IN ITEMS FORBIDDEN_SOURCE_DIR FORBIDDEN_BUILD_DIR)
    if(DEFINED ${variable} AND NOT "${${variable}}" STREQUAL "")
      string(FIND "${contents}" "${${variable}}" found)
      if(NOT found EQUAL -1)
        message(FATAL_ERROR "Source/build path leaked through installed SDK: ${${variable}}")
      endif()
    endif()
  endforeach()
endforeach()
bundleRun("${CMAKE_COMMAND}" ${configureArgs})
bundleRun("${CMAKE_COMMAND}" --build "${consumerBuild}" --config Release --parallel 2)
bundleRun("${CMAKE_CTEST_COMMAND}" --test-dir "${consumerBuild}" -C Release
  --output-on-failure --no-tests=error)
if(DEFINED PYTHON_EXECUTABLE AND NOT PYTHON_EXECUTABLE STREQUAL "")
  bundleRun("${PYTHON_EXECUTABLE}" "${BUNDLE_DIR}/verify/check_links.py" "${BUNDLE_DIR}/docs/html")
endif()
file(WRITE "${TEST_WORK_DIR}/smoke-receipt.txt"
  "payload_sha256=passed\nfour_examples_check=passed\nrelocated_sdk_consumer=passed\nnative_acceptance=not_run_by_headless_smoke\n")
message(STATUS "Bundle hashes, four finite checks and relocated Release SDK consumer passed; evidence: ${TEST_WORK_DIR}")
