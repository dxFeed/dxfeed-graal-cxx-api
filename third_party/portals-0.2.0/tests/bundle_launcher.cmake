cmake_minimum_required(VERSION 3.24)
foreach(variable IN ITEMS SOURCE_DIR BINARY_DIR PROGRAM)
  if(NOT DEFINED ${variable})
    message(FATAL_ERROR "Launcher test requires ${variable}")
  endif()
endforeach()
include("${SOURCE_DIR}/tools/package/common.cmake")
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef runId)
set(root "${BINARY_DIR}/bundle-launcher-${runId}")
bundleRequireNewPath(root)
set(payload "${root}/перемещённый пакет с пробелами")
set(foreign "${root}/foreign cwd")
file(MAKE_DIRECTORY "${payload}/bin" "${foreign}")
file(COPY "${PROGRAM}" DESTINATION "${payload}/bin")
if(CMAKE_HOST_WIN32)
  if(NOT DEFINED POWERSHELL_EXECUTABLE)
    message(FATAL_ERROR "Windows launcher test requires POWERSHELL_EXECUTABLE")
  endif()
  file(COPY "${SOURCE_DIR}/tools/package/run.ps1" DESTINATION "${payload}")
  set(command "${POWERSHELL_EXECUTABLE}" -NoProfile -File "${payload}/run.ps1")
else()
  file(COPY "${SOURCE_DIR}/tools/package/run.sh" DESTINATION "${payload}")
  set(command /bin/sh "${payload}/run.sh")
endif()
execute_process(COMMAND ${command} gallery --check WORKING_DIRECTORY "${foreign}"
  TIMEOUT 20 RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
file(WRITE "${root}/gallery.log" "${output}\n${error}\nresult=${result}\n")
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Relocated launcher finite check failed: ${result}; ${error}")
endif()
execute_process(COMMAND ${command} invalid-example WORKING_DIRECTORY "${foreign}"
  TIMEOUT 10 RESULT_VARIABLE invalidResult OUTPUT_VARIABLE invalidOutput ERROR_VARIABLE invalidError)
if(invalidResult EQUAL 0)
  message(FATAL_ERROR "Launcher accepted an unsupported example")
endif()
message(STATUS "Relocated launcher and invalid example checks passed; evidence: ${root}")
